        "g": "7e754d0625aeb30f",
        "name": "Telegram Alert",
        "func": "// ضع بياناتك هنا بين علامتي التنصيص\nvar token = \"8888903999:AAHAy7hvfw0t1jDCgUdo_dN0qZxomcIV4Ek\";\nvar chatId = \"5075413044\";\nvar direction = \"\";\n\n// استخراج رقم المسار سواء كان رقماً أو كائناً\nvar lane = (typeof msg.payload === 'object' && msg.payload !== null) ? (msg.payload.lane || msg.payload.emergencyLane || 1) : parseInt(msg.payload) || 1;\n\n// تحويل الرقم إلى مسار\nif (lane == 1) direction = \"الشمال\";\nelse if (lane == 2) direction = \"الشرق\";\nelse if (lane == 3) direction = \"الجنوب\";\nelse if (lane == 4) direction = \"الغرب\";\n\n// تجهيز نص الرسالة\nvar text = \"🚨 تنبيه نظام سند: تم تفعيل وضع الطوارئ في مسار \" + direction;\n\n// دمج الرابط مع البيانات\nmsg.url = \"https://api.telegram.org/bot\" + token + \"/sendMessage?chat_id=\" + chatId + \"&text=\" + encodeURIComponent(text);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
