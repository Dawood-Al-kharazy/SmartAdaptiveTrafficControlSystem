        "func": "var data = flow.get(\"trafficData\");\nif (!data || typeof data !== \"object\") {\n    data = {\n        \"nCars\": 0,\n        \"eCars\": 0,\n        \"sCars\": 0,\n        \"wCars\": 0,\n        \"state\": 0\n    };\n}\nmsg.payload = data;\nmsg.statusCode = 200;\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
