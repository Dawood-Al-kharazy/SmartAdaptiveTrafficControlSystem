    {
        "id": "emer_resp_format_01",
        "type": "function",
        "z": "f2e7a51a6ff84051",
        "g": "12a33292a5fa9ec5",
        "name": "Format Emergency Response",
        "func": "var lane = 1;\nif (typeof msg.payload === \"object\" && msg.payload !== null) {\n    lane = msg.payload.lane || msg.payload.emergencyLane || 1;\n} else if (typeof msg.payload === \"number\" || typeof msg.payload === \"string\") {\n    lane = parseInt(msg.payload) || 1;\n}\nmsg.payload = {\n    \"status\": \"success\",\n    \"message\": \"Emergency mode activated for lane \" + lane,\n    \"lane\": lane\n};\nmsg.statusCode = 200;\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 1260,
