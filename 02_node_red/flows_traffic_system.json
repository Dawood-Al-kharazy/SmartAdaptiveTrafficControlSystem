        "name": "Email Alert",
        "func": "var direction = \"\";\n\nvar lane = (typeof msg.payload === 'object' && msg.payload !== null) ? (msg.payload.lane || msg.payload.emergencyLane || 1) : parseInt(msg.payload) || 1;\n\nif (lane == 1) direction = \"الشمال\";\nelse if (lane == 2) direction = \"الشرق\";\nelse if (lane == 3) direction = \"الجنوب\";\nelse if (lane == 4) direction = \"الغرب\";\n\nmsg.topic = \"🚨 إنذار طوارئ: تقاطع المرور\";\nmsg.payload = \"مرحباً،\\n\\nيرجى العلم بأنه تم تفعيل وضع الطوارئ، وتم فتح الإشارة الخضراء لمرور حالة إسعاف في مسار: \" + direction + \".\\n\\n-- نظام الإدارة المرورية --\";\n\nreturn msg;",
