    {
        "id": "norm_emergency_cmd_01",
        "type": "function",
        "z": "f2e7a51a6ff84051",
        "g": "12a33292a5fa9ec5",
        "name": "Normalize Emergency Command",
        "func": "var lane = 1;\nif (typeof msg.payload === \"object\" && msg.payload !== null) {\n    lane = msg.payload.lane || msg.payload.emergencyLane || 1;\n} else if (typeof msg.payload === \"number\" || typeof msg.payload === \"string\") {\n    lane = parseInt(msg.payload) || 1;\n}\n\n// Update emergencyLane in flow memory so Flutter sees it immediately!\nvar traffic = flow.get(\"trafficData\") || {};\ntraffic.emergencyLane = lane;\nflow.set(\"trafficData\", traffic);\n\n// Pass normalized number to MQTT and downstream nodes\nmsg.payload = lane;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
