            ]
        ]
    },
    {
        "id": "func_current_light_status_01",
        "type": "function",
        "z": "f2e7a51a6ff84051",
        "g": "794de1d76dea8a5d",
        "name": "Format Current Light State",
        "func": "var s = msg.payload.state;\nvar text = \"\";\n\nif (s === 0) text = \"🟢 الشمال (North) : أخضر (GREEN)\";\nelse if (s === 1) text = \"🟡 الشمال (North) : أصفر (YELLOW)\";\nelse if (s === 2) text = \"🟢 الشرق (East) : أخضر (GREEN)\";\nelse if (s === 3) text = \"🟡 الشرق (East) : أصفر (YELLOW)\";\nelse if (s === 4) text = \"🟢 الجنوب (South) : أخضر (GREEN)\";\nelse if (s === 5) text = \"🟡 الجنوب (South) : أصفر (YELLOW)\";\nelse if (s === 6) text = \"🟢 الغرب (West) : أخضر (GREEN)\";\nelse if (s === 7) text = \"🟡 الغرب (West) : أصفر (YELLOW)\";\nelse text = \"⚪ غير معروف (\" + s + \")\";\n\nmsg.payload = text;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1940,
        "y": 1460,
        "wires": [
